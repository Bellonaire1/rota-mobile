# Port on which the Express server listens
PORT=

# Runtime environment (e.g. development, test, production)
NODE_ENV=

# PostgreSQL database connection URL for Prisma
DATABASE_URL=

# PostgreSQL direct connection URL for Prisma migrations/admin tasks
DIRECT_URL=

# Secret used to sign short-lived access tokens (use a random value of 32+ characters)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters

# Access token lifetime in minutes
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Paystack test-mode webhook verification secret
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_REQUEST_TIMEOUT_MS=10000
