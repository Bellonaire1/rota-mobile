// Prisma schema for Rota Backend
// Database: PostgreSQL
// Note: Business models will be added in subsequent feature milestones.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TeamRole {
  OWNER
  MANAGER
  STAFF
}

enum ShiftStatus {
  SCHEDULED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamsCreated Team[]           @relation("CreatedTeams")
  memberships  TeamMembership[]
  authSessions AuthSession[]
  assignedShifts Shift[]         @relation("AssignedShifts")
  createdShifts  Shift[]         @relation("CreatedShifts")
}

model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Team {
  id              String   @id @default(uuid())
  name            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy   User             @relation("CreatedTeams", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships TeamMembership[]
  shifts      Shift[]

  @@index([createdByUserId])
}

model TeamMembership {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Shift {
  id                String      @id @default(uuid())
  teamId            String
  assignedToUserId  String
  createdByUserId   String
  title             String
  startsAt          DateTime    @db.Timestamptz(3)
  endsAt            DateTime    @db.Timestamptz(3)
  status            ShiftStatus @default(SCHEDULED)
  cancelledAt       DateTime?   @db.Timestamptz(3)
  cancelledByUserId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  team       Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignedShifts", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  createdBy  User @relation("CreatedShifts", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([teamId, startsAt])
  @@index([teamId, status, startsAt])
  @@index([assignedToUserId, startsAt])
}
